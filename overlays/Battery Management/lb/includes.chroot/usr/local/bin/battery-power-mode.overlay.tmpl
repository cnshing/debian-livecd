#!/bin/sh

set -eu

BAT_DEVICE="/org/freedesktop/UPower/devices/DisplayDevice"
CURRENT=""
PROFILES=""
CHARGING=""

# Defer to tlp.conf is scaling_governor is configured by exiting.
for f in /etc/tlp.conf /etc/tlp.d/*.conf; do
    [ -f "$f" ] || continue
    if grep -qE '^[[:space:]]*CPU_SCALING_GOVERNOR_ON_(AC|BAT)[[:space:]]*=[[:space:]]*[^[:space:]]' "$f"; then
        echo "battery-power-mode: TLP manages scaling_governor via $f, deferring to it" >&2
        exit 0
    fi
done

governor_available() {
    want="$1"
    for gov in $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null); do
        if [ "$gov" = "$want" ]; then
            return 0
        fi
    done
    return 1
}

set_governor() {
    # sh has no locals - do not reuse $gov
    for sysfs_gov in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_governor; do
        [ -w "$sysfs_gov" ] && echo "$1" > "$sysfs_gov" 2>/dev/null || true
    done
}

apply() {
    pct="$1"
    state="$2"
    target=""
    reason="${pct}%"
    # UPower Device.State: 1 charging, 4 fully charged, 5 pending charge (e.g. held
    # by a charge threshold) all mean plugged in.
    case "$state" in
        1|4|5) target="$CHARGING"; reason="${pct}% charging" ;;
    esac
    if [ -z "$target" ]; then
        case "$pct" in ''|*[!0-9]*) return ;; esac
        for p in $PROFILES; do
            start=${p%%,*}
            rest=${p#*,}
            end=${rest%%,*}
            gov=${rest#*,}
            if [ "$pct" -ge "$start" ] && [ "$pct" -le "$end" ]; then
                target="$gov"
                break
            fi
        done
    fi
    if [ -n "$target" ] && [ "$CURRENT" != "$target" ]; then
        set_governor "$target"
        echo "battery-power-mode: $reason -> $target" >&2
        CURRENT="$target"
    fi
}

# Loads the battery profiles, only if the configuration defines them as non-empty values.
# Governor defaults to the profile's own key name (e.g. "performance") unless overridden.
{% for name, profile in overlay.config.profiles.items() %}
{%- set gov = profile.governor if (profile.governor is defined and profile.governor != '') else name %}
{%- if profile.start is defined and profile.start != '' and profile.end is defined and profile.end != '' %}
if governor_available "{{ gov }}"; then
    PROFILES="$PROFILES {{ profile.start }},{{ profile.end }},{{ gov }}"
else
    echo "battery-power-mode: governor '{{ gov }}' unavailable, skipping profile '{{ name }}'" >&2
fi
{%- else %}
echo "battery-power-mode: profile '{{ name }}' missing start/end, skipping" >&2
{%- endif %}
{% endfor %}

# Governor to use whenever plugged in, regardless of  battery percentage.
{%- if overlay.config.charging is defined and overlay.config.charging != '' %}
if governor_available "{{ overlay.config.charging }}"; then
    CHARGING="{{ overlay.config.charging }}"
else
    echo "battery-power-mode: governor '{{ overlay.config.charging }}' unavailable, ignoring charging" >&2
fi
{%- endif %}

if [ -z "$PROFILES" ] && [ -z "$CHARGING" ]; then
    echo "battery-power-mode: no usable profiles configured, exiting" >&2
    exit 0
fi

if ! upower -i "$BAT_DEVICE" 2>/dev/null | grep -qE '^[[:space:]]*power supply:[[:space:]]*yes'; then
    echo "battery-power-mode: no battery present, exiting" >&2
    exit 0
fi

# plug/unplugs between this read and busctl subscribing is missed until the next State signal; start the monitor first and read inside the loop
set -- $(busctl get-property org.freedesktop.UPower "$BAT_DEVICE" org.freedesktop.UPower.Device Percentage State)
PCT=${2%%.*}
STATE=${4:-}
apply "$PCT" "$STATE"


busctl monitor --system --json=short \
    --match="type=signal,sender=org.freedesktop.UPower,path=$BAT_DEVICE,interface=org.freedesktop.DBus.Properties,member=PropertiesChanged" |
jq --unbuffered -r '.payload.data[1] | select(has("Percentage") or has("State"))
    | "\(.Percentage.data // "-" | if . == "-" then . else floor end) \(.State.data // "-")"' |
while IFS=' ' read -r pct state; do
    [ "$pct" = "-" ] || PCT="$pct"
    [ "$state" = "-" ] || STATE="$state"
    apply "$PCT" "$STATE"
done
