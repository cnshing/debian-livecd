#!/bin/sh
# After `user-setup`, this will copy any of the selected choices' `import` file paths over to the installed system and run the overlays' post-install and user-post-install hooks.

set -e

LIB=/usr/lib/debian-livecd-installer
. $LIB/manifest.sh
. $LIB/import.sh

# Logs what was and was not installed
mkdir -p /target/var/log/installer/debian-livecd-installer
cp -a "$STATE/selected" "$STATE/deselected" "$STATE/manifest" /target/var/log/installer/debian-livecd-installer/ 2>/dev/null || true

user=$(debconf-get passwd/username || true)
entry=
if [ "$(debconf-get passwd/make-user || true)" != false ] && [ -n "$user" ]; then
	entry=$(grep "^$user:" /target/etc/passwd || true)
fi
uid=$(echo "$entry" | cut -d: -f3)
gid=$(echo "$entry" | cut -d: -f4)
home=$(echo "$entry" | cut -d: -f6)

import_copy

# A failing hook does not fail any other hooks
set +e
export CHROOT=/target
export DEFAULT_USER=
[ -z "$entry" ] || DEFAULT_USER=$user
mkdir -p $CHROOT/var/log/install

. $LIB/post-install.sh
if [ -n "$DEFAULT_USER" ]; then
	. $LIB/user-post-install.sh
	rm -rf $CHROOT/home/$DEFAULT_USER/install
else
	log "no user account, so the user-post-install hooks did not run"
fi

rm -rf $CHROOT/root/install
exit 0
