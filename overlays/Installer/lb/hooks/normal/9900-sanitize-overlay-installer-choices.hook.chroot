#!/bin/sh
# Some overlays supporting debian-installer implicitly require another overlay to be enabled in order to function correctly. This script checks the overlays' choices in `/usr/share/debian-livecd-installer` for any developer overlay misconfigurations.
set -u

M=/usr/share/debian-livecd-installer
[ -d "$M" ] || exit 0
states=$(mktemp)
trap 'rm -f "$states"' EXIT

warn() { echo "[Installer] ==> WARNING: $*" >&2; }
# Reads a file line by line, without comments and empty lines
list() { sed -e 's/[[:space:]]*#.*//' -e '/^$/d' "$1" 2> /dev/null || true; }
exists() { [ -e "$1" ] || [ -L "$1" ]; }
# Lists the installed packages matching the names or globs on stdin
installed() {
	while read -r p; do
		dpkg-query -W -f '${db:Status-Status} ${Package}\n' "$p" 2> /dev/null
	done | awk '$1 == "installed" { print $2 }' | sort -u
}
# Lists the packages with files at or below the path, or its /usr-less alias
owners() {
	for p in "$1" "$(echo "$1" | sed -n 's#^/usr\(/\(s\?bin\|lib[^/]*\)/\)#\1#p')"; do
		[ -n "$p" ] && dpkg-query -S "$p" "$p/*" 2> /dev/null
	done | grep -v '^diversion' | sed 's/: .*//' | tr ', ' '\n\n' | sed -e '/^$/d' -e 's/:.*//' | sort -u
}

present() {
	[ -z "$(list "$1/packages" | installed)" ] || return 0
	while read -r p; do exists "$p" && return 0; done << EOF
$(list "$1/exclude")
EOF
	[ -f "$1/import" ] || [ -f "$1/deselect" ]
}

leave_out() {
	echo "[Installer] ==> ${1#"$M"/}: $2, left out"
	rm -rf "$1"
}
# Removes choices with nothing in the image
for label in "$M"/*/*/label; do
	[ -f "$label" ] || continue
	present "${label%/label}" || leave_out "${label%/label}" "not in this image"
done
# Removes choices whose requirements are not in the image
for label in "$M"/*/*/label; do
	dir=${label%/label}
	[ -f "$dir/requires" ] || continue
	for required in $(list "$dir/requires"); do
		[ -d "$M/$required" ] && continue 2
	done
	leave_out "$dir" "what it needs is not in this image"
done
# Removes sections that are left empty
for label in "$M"/*/label; do
	[ -f "$label" ] || continue
	ls "${label%/label}"/*/label > /dev/null 2>&1 || leave_out "${label%/label}" "nothing to choose"
done

# Warns about any choice that could break the installed system, without failing the build
for label in "$M"/*/*/label; do
	dir=${label%/label}
	id=${dir#"$M"/}
	[ -f "$label" ] || continue
	purged=$(list "$dir/packages" | installed)
	list "$dir/packages" | while read -r p; do
		[ -n "$(echo "$p" | installed)" ] || warn "$id: no installed package $p"
	done
	# Simulates the installer on a copy of apt's marks: packages that installed packages still depend on or recommend are kept
	if [ -n "$purged" ]; then
		cp /var/lib/apt/extended_states "$states" 2> /dev/null || : > "$states"
		apt-mark -o Dir::State::extended_states="$states" auto $purged > /dev/null
		removed=$(apt-get -s -o Dir::State::extended_states="$states" autoremove | awk '/^(Remv|Purg) / { sub(/:.*/, "", $2); print $2 }')
		kept=$(printf '%s\n' "$purged" | grep -vxF "$removed")
		[ -z "$kept" ] || warn "$id: deselecting it keeps $(echo $kept), as other installed packages need them"
		purged=$(printf '%s\n' "$purged" | grep -vxF "$kept")
	fi
	# An excluded path holding files of a package that stays installed is not excluded
	safe=
	while read -r p; do
		[ -n "$p" ] || continue
		exists "$p" || warn "$id: no $p"
		kept_by=$(for owner in $(owners "$p"); do printf '%s\n' "$purged" | grep -qxF "$owner" || echo "$owner"; done)
		if [ -n "$kept_by" ]; then
			warn "$id: not excluding $p, it has files of $(echo $kept_by), which deselecting $id keeps"
		else
			safe="$safe$p
"
		fi
	done << EOF
$(list "$dir/exclude")
EOF
	[ ! -f "$dir/exclude" ] || printf '%s' "$safe" > "$dir/exclude"
	echo "[Installer] ==> $id: checked"
done
