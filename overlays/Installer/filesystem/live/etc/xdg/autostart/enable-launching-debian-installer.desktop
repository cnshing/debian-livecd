[Desktop Entry]
Type=Application
Name=Enable Launching Install Debian
Comment=Trusts the Install Debian desktop icon for DING
# touch makes Desktop Icons NG redraws the icon to visually show it as trusted
Exec=sh -c "cd \\$HOME/Desktop && gio set debian-installer-launcher.desktop metadata::trusted true && touch debian-installer-launcher.desktop"
NoDisplay=true
X-GNOME-Autostart-Phase=Initialization
