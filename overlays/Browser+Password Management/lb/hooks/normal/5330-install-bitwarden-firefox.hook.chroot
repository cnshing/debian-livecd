#!/bin/sh

set -eu

ID="{446900e4-71c2-419f-a6a7-df9c091e268b}"
URL="https://addons.mozilla.org/firefox/downloads/latest/bitwarden-password-manager/latest.xpi"
DEST_DIR="/usr/share/mozilla/extensions/{ec8030f7-c20a-464f-9b0e-13a3a9e97384}"

echo "[Bitwarden Firefox] ==> Downloading extension..."
mkdir -p "$DEST_DIR"
if ! curl -fL "$URL" -o "$DEST_DIR/$ID.xpi"; then
    echo "[Bitwarden Firefox] ==> ERROR: Failed to download $URL" >&2
    exit 1
fi

echo "[Bitwarden Firefox] ==> Installed successfully"
