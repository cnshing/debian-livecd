#!/bin/sh

set -eu

ID="ghmbeldphafepmbegfdlkpapadhbakde"
URL="https://clients2.google.com/service/update2/crx?response=redirect&prodversion=120.0&acceptformat=crx2,crx3&x=id%3D${ID}%26installsource%3Dondemand%26uc"
DEST_DIR="/opt/google/chrome/extensions"
CRX="$DEST_DIR/$ID.crx"

echo "[Proton Pass Chrome] ==> Downloading extension..."
mkdir -p "$DEST_DIR"
chmod 755 "$DEST_DIR"
if ! curl -fL "$URL" -o "$CRX"; then
    echo "[Proton Pass Chrome] ==> ERROR: Failed to download $URL" >&2
    exit 1
fi
chmod 644 "$CRX"

VERSION="$(unzip -p "$CRX" manifest.json | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | sed -E 's/.*"([^"]+)"$/\1/')"
if [ -z "$VERSION" ]; then
    echo "[Proton Pass Chrome] ==> ERROR: Failed to read version from downloaded crx" >&2
    exit 1
fi

cat > "$DEST_DIR/$ID.json" <<EOF
{
  "external_crx": "$CRX",
  "external_version": "$VERSION"
}
EOF
chmod 644 "$DEST_DIR/$ID.json"

echo "[Proton Pass Chrome] ==> Installed successfully ($VERSION)"
