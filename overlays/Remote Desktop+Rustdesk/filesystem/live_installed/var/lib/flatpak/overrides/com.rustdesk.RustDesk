# This file aims to give RustDesk system level permissions outside of the Flatpak sandbox.

[Context]

# Needed for the GUI under Wayland and the GNOME shortcuts-inhibit path.
# Absent from manifests between 2025-11-19 and 2026-02-11; restored in:
# https://github.com/rustdesk/rustdesk/commit/2842315b
sockets=wayland;

# Allows direct remote desktop without the typical Flatpak RemoteDesktop fallback.
# `devices=all` must be granted because  no narrower option exposes /dev/uinput.
#   opens /dev/uinput:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/server/uinput.rs#L1157
#   gate, wayland_use_rdp_input() = !is_x11() && !is_server():
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/server/input_service.rs#L2385-L2387
#   fallback when unavailable:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/server/connection.rs#L1990-L1993
devices=all;


# Remove Wallpaper Feature
#   WallPaperRemover:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/platform/linux.rs#L2660-L2674
#   wallpaper crate dep:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/Cargo.toml#L176
filesystems=xdg-run/dconf;~/.config/dconf:ro;

[Session Bus Policy]

# Fixes "No active console user logged on, please connect and logon first.". Allows for Flatpak sandbox escape.
#   run_loginctl, flatpak-spawn branch:
#   https://github.com/rustdesk/hbb_common/blob/c2d8a6db2e2755f23bd12f6d5404063766ab6144/src/platform/linux.rs#L309-L321
#   _get_values_of_seat0, returns empty on failure:
#   https://github.com/rustdesk/hbb_common/blob/c2d8a6db2e2755f23bd12f6d5404063766ab6144/src/platform/linux.rs#L213-L259
#   get_active_username:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/platform/linux.rs#L1309-L1314
#   into PeerInfo:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/server/connection.rs#L1771
#   error surfaced:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/ui_session_interface.rs#L1794-L1796
org.freedesktop.Flatpak=talk

# clear_gnome_shortcuts_inhibitor_permission()
#   const:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/platform/linux.rs#L2750
#   DeletePermission call:
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/platform/linux.rs#L2764-L2776
org.freedesktop.impl.portal.PermissionStore=talk

# Display / resolution enumeration.
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/platform/linux.rs#L191-L193
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/libs/scrap/src/wayland/display.rs#L151-L155
org.gnome.Mutter.DisplayConfig=talk

# Idle inhibit during an active session, SESSION_INHIBIT_TARGETS.
# GNOME is target[0], PowerManagement (powerdevil / xfce4) is target[1].
#   https://github.com/rustdesk/rustdesk/blob/7423dced37845c48093b6f71bd82e4a16cc8c79d/src/platform/linux.rs#L2360-L2378
org.gnome.SessionManager=talk
org.freedesktop.PowerManagement=talk


[Environment]

# Remove Wallpaper Feature
DCONF_USER_CONFIG_DIR=.config/dconf