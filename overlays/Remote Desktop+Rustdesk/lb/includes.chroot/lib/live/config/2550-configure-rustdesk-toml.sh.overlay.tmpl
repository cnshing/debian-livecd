#!/bin/sh

RUSTDESK_TOML="{{ overlay.config.configPaths.RustDeskToml }}"
RUSTDESK_TOML2="{{ overlay.config.configPaths.RustDesk2Toml }}"
DST="/home/${LIVE_USERNAME:-user}/.var/app/com.rustdesk.RustDesk/config/rustdesk"
mkdir -p "$DST"

if [ -f "$RUSTDESK_TOML" ]; then
    cp -f "$RUSTDESK_TOML" "$DST"/RustDesk.toml
    chmod 600 "$DST"/RustDesk.toml
else
    echo "rustdesk: no config found at $RUSTDESK_TOML, skipping" >&2
fi

if [ -f "$RUSTDESK_TOML2" ]; then
    cp -f "$RUSTDESK_TOML2" "$DST"/RustDesk2.toml
    chmod 600 "$DST"/RustDesk2.toml
else
    echo "rustdesk: no config found at $RUSTDESK_TOML2, skipping" >&2
fi
