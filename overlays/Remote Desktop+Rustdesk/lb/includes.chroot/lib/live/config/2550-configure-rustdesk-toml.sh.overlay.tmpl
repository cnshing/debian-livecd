#!/bin/sh

# If a configured path is under /run/live/medium/, assume the user means the file at the root of the drive the image booted from.
# Under Ventoy or toram, that drive is not what is mounted at /run/live/medium. With the copy-live-medium-files= boot parameter, the initramfs copies those files to /run/copy-live-medium-files before toram (see /usr/lib/live/boot/9995-copy-live-medium-files.sh).

from_stick() {
    path="$1"
    name="${path#/run/live/medium/}" # same as path if not under /run/live/medium/
    copy="/run/copy-live-medium-files/$name"

    if [ "$name" != "$path" ] && [ -f "$copy" ]; then
        echo "$copy"
    else
        echo "$path"
    fi
}

RUSTDESK_TOML="$(from_stick "{{ overlay.config.configPaths.RustDeskToml }}")"
RUSTDESK_TOML2="$(from_stick "{{ overlay.config.configPaths.RustDesk2Toml }}")"
USERNAME="${LIVE_USERNAME:-live}"
# live-config only exports its default username ("user"); like its own components (0030-user-setup), read username from the boot parameters.
for _PARAMETER in ${LIVE_CONFIG_CMDLINE:-$(cat /proc/cmdline)}; do
    case "${_PARAMETER}" in
        live-config.username=*|username=*) USERNAME="${_PARAMETER#*username=}" ;;
    esac
done
USER_HOME="$(getent passwd "$USERNAME" 2>/dev/null | cut -d: -f6)"

if [ -z "$USER_HOME" ]; then
    echo "rustdesk: could not determine home directory to write configuration for user '$USERNAME'" >&2
    exit 1
fi

CFG_DST="$USER_HOME/.config/rustdesk"

mkdir -p "$CFG_DST"

if [ -f "$RUSTDESK_TOML" ]; then
    cp -f "$RUSTDESK_TOML" "$CFG_DST/RustDesk.toml"
    chmod 600 "$CFG_DST/RustDesk.toml"
else
    echo "rustdesk: no config found at $RUSTDESK_TOML, skipping" >&2
fi

if [ -f "$RUSTDESK_TOML2" ]; then
    cp -f "$RUSTDESK_TOML2" "$CFG_DST/RustDesk2.toml"
    chmod 600 "$CFG_DST/RustDesk2.toml"
else
    echo "rustdesk: no config found at $RUSTDESK_TOML2, skipping" >&2
fi

chown -R "$USERNAME:$USERNAME" "$USER_HOME/.config/rustdesk"