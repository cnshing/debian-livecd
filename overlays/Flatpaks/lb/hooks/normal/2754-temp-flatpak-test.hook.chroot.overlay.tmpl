#!/bin/sh
# TEMPORARY verification hook. Delete before merging.
#
# Verifies that explicitly enumerating the pulled closure and deploying it
# offline actually deploys ALL of it -- the gap found in the previous run,
# where an offline `--no-pull` of the app alone deployed only 2 of 8 refs.
#
# NOTE: rendered as a Jinja2 template by src/util.py -- no double-brace or
# brace-percent sequences.
# NOTE: lb_chroot_hooks aborts the build on non-zero exit. This never fails.
# Grep the build log for ENUM.

M="ENUM"
PKGS="{{ overlay.config.packages | join(' ') }}"

say() { echo "${M}: $*"; }
hdr() { echo "${M}:"; echo "${M}: ===== $* ====="; }
note() { echo "${M}: >>> $*"; }

run() {
    _label="$1"; shift
    _out=$("$@" 2>&1); _rc=$?
    if [ "${_rc}" -eq 0 ]; then say "PASS      ${_label}"
    else say "FAIL rc=${_rc}  ${_label}"; fi
    [ -n "${_out}" ] && echo "${_out}" | sed "s|^|${M}:        \| |"
    unset _label _out _rc
}

SCRATCH=/var/tmp/verify-enum
export FLATPAK_SYSTEM_DIR="${SCRATCH}/system"
export FLATPAK_SYSTEM_CACHE_DIR="${SCRATCH}/cache-warm"
export FLATPAK_DOWNLOAD_TMPDIR="${SCRATCH}/tmp"
REPO="${FLATPAK_SYSTEM_DIR}/repo"
mkdir -p "${FLATPAK_SYSTEM_DIR}" "${FLATPAK_SYSTEM_CACHE_DIR}" "${FLATPAK_DOWNLOAD_TMPDIR}"

commitmeta_size() {
    _c=$(cat "${REPO}/refs/remotes/flathub/$1" 2>/dev/null)
    [ -z "${_c}" ] && { echo 0; return; }
    _f="${REPO}/objects/$(echo "${_c}" | cut -c1-2)/$(echo "${_c}" | cut -c3-).commitmeta"
    if [ -f "${_f}" ]; then wc -c < "${_f}" | tr -d ' '; else echo 0; fi
    unset _c _f
}
all_repo_refs() {
    (cd "${REPO}/refs/remotes/flathub" 2>/dev/null && find . -type f | sed 's|^\./||' | sort)
}
# ground truth: does <system>/<ref>/active exist?
is_deployed() { [ -e "${FLATPAK_SYSTEM_DIR}/$1/active" ]; }

# ===========================================================================
hdr "0. pull the closure (--no-deploy), same as before"
run "remote-add flathub" \
    flatpak --system remote-add --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo
for id in ${PKGS}; do
    run "install --no-deploy ${id}" \
        flatpak --system install --no-deploy -y --noninteractive flathub "${id}"
done

# ===========================================================================
hdr "1. enumerate + classify by commitmeta size (592 = plain, ~1.5M = extra-data)"
PLAIN=""; EXTRA=""
for r in $(all_repo_refs); do
    sz=$(commitmeta_size "${r}")
    if [ "${sz}" -gt 100000 ]; then
        EXTRA="${EXTRA} ${r}"; printf "%s:   EXTRA %10s  %s\n" "${M}" "${sz}" "${r}"
    else
        PLAIN="${PLAIN} ${r}"; printf "%s:   plain %10s  %s\n" "${M}" "${sz}" "${r}"
    fi
done
say "  plain count: $(echo ${PLAIN} | wc -w)   extra count: $(echo ${EXTRA} | wc -w)"

# ===========================================================================
hdr "2. go cold + offline"
rm -rf "${SCRATCH}/cache-warm" /var/tmp/flatpak-cache-* \
       "${HOME}/.cache/flatpak" "${HOME}/.local/share/flatpak"
FAKEHOME="${SCRATCH}/fakehome"; rm -rf "${FAKEHOME}"; mkdir -p "${FAKEHOME}"
COLDCACHE="${SCRATCH}/cache-cold"; mkdir -p "${COLDCACHE}"

offline() {
    _label="$1"; shift
    run "${_label}" unshare -n env -i \
        HOME="${FAKEHOME}" \
        PATH="/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin" \
        FLATPAK_SYSTEM_DIR="${FLATPAK_SYSTEM_DIR}" \
        FLATPAK_SYSTEM_CACHE_DIR="${COLDCACHE}" \
        flatpak --system install --no-pull -y --noninteractive "$@"
    unset _label
}

# ===========================================================================
hdr "3. TEST A: all plain refs in ONE invocation (lets the transaction order them)"
note "Single call so runtimes are deployed before their extensions."
offline "deploy $(echo ${PLAIN} | wc -w) plain refs at once" flathub ${PLAIN}

note "Ground truth -- deploy dir present on disk? (not trusting flatpak list)"
MISSING=""
for r in ${PLAIN}; do
    if is_deployed "${r}"; then
        printf "%s:   DEPLOYED  %8s  %s\n" "${M}" \
            "$(du -sh "${FLATPAK_SYSTEM_DIR}/${r}" 2>/dev/null | cut -f1)" "${r}"
    else
        MISSING="${MISSING} ${r}"
        printf "%s:   MISSING             %s\n" "${M}" "${r}"
    fi
done
if [ -z "${MISSING}" ]; then
    note "ALL plain refs deployed by a single call. Enumeration works."
else
    note "STILL MISSING:${MISSING}"
fi

# ===========================================================================
hdr "4. TEST B: per-ref loop for anything test A missed"
if [ -z "${MISSING}" ]; then
    say "  nothing missing -- skipped"
else
    for r in ${MISSING}; do
        offline "deploy single ref ${r}" flathub "${r}"
        if is_deployed "${r}"; then say "  -> now DEPLOYED: ${r}"
        else say "  -> STILL MISSING: ${r}"; fi
    done
fi

# ===========================================================================
hdr "5. cross-check: what does flatpak list report vs the filesystem?"
note "If list shows fewer than the DEPLOYED count above, the previous run's"
note "'only 2 of 8' finding was a reporting artefact, not a real gap."
flatpak --system list --columns=ref,options 2>&1 | sed "s|^|${M}:        \| |"
say "  filesystem deploy dirs:"
find "${FLATPAK_SYSTEM_DIR}/app" "${FLATPAK_SYSTEM_DIR}/runtime" \
     -name active -maxdepth 4 2>/dev/null \
    | sed "s|${FLATPAK_SYSTEM_DIR}/||; s|/active$||" | sort \
    | sed "s|^|${M}:        \| |"

note "'partial' in the options column = subpath install (small)."
note "No 'partial' on .Locale means we deployed EVERY language -- size risk."

# ===========================================================================
hdr "6. exports + trigger staleness (predicts the ISO app-grid symptom)"
say "  .desktop files exported:"
ls "${FLATPAK_SYSTEM_DIR}/exports/share/applications/" 2>&1 \
    | sed "s|^|${M}:        \| |"
for f in exports/share/applications/mimeinfo.cache \
         exports/share/icons/hicolor/icon-theme.cache; do
    if [ -e "${FLATPAK_SYSTEM_DIR}/${f}" ]; then say "  present: ${f}"
    else say "  ABSENT:  ${f}   (triggers skipped -- must regenerate on first boot)"; fi
done

# ===========================================================================
hdr "7. extra-data refs still reach apply_extra with runtimes now deployed"
note "Runtime is deployed now, so flatpak_find_deploy_for_ref() should succeed"
note "and we should get 'apply_extra script failed' (bwrap), NOT a missing-runtime error."
for r in ${EXTRA}; do
    offline "offline deploy ${r}" flathub "${r}"
done

# ===========================================================================
hdr "8. accounting"
say "  repo:            $(du -sh "${REPO}" 2>/dev/null | cut -f1)"
say "  app deploys:     $(du -sh "${FLATPAK_SYSTEM_DIR}/app" 2>/dev/null | cut -f1)"
say "  runtime deploys: $(du -sh "${FLATPAK_SYSTEM_DIR}/runtime" 2>/dev/null | cut -f1)"
say "  TOTAL:           $(du -sh "${FLATPAK_SYSTEM_DIR}" 2>/dev/null | cut -f1)"
note "TOTAL near repo size = hardlinked. TOTAL near repo+deploys = paying twice."

hdr "cleanup"
rm -rf "${SCRATCH}" /var/tmp/flatpak-cache-*
rm -rf "${HOME}/.cache/flatpak" "${HOME}/.local/share/flatpak"
say "  done"
hdr "done"
exit 0