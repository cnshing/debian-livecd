#!/bin/sh
sysctl -w kernel.unprivileged_userns_clone=1

# Run Flatpak setup inside systemd-nspawn instead of plain chroot from https://github.com/clayrisser/linux-factory/blob/main/overlays/flatpak/lb/hooks/normal/2010-flatpak.hook.chroot.overlay.tmpl and https://bbs.archlinux.org/viewtopic.php?id=309480
systemd-nspawn -D / --as-pid2 --capability=all -q /bin/sh -c '
set -eu

flatpak --system remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# Enable setuid temporarily for bubblewrap
chmod u+s $(which bwrap)

{% for pkg in overlay.config.packages %}
flatpak install -y --noninteractive --system flathub {{ pkg }}
{% endfor %}

# Remove setuid again for safety
chmod u-s $(which bwrap)
'